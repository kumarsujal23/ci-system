# Copy to .env and adjust as needed. All values are read by
# backend/app/config.py (pydantic-settings, prefix CI_).

CI_DATABASE_URL=postgresql+psycopg2://ci:ci@postgres:5432/ci
CI_REDIS_URL=redis://redis:6379/0

CI_JOB_LEASE_SECONDS=60
CI_WORKER_HEARTBEAT_SECONDS=10
CI_WORKER_DEAD_AFTER_SECONDS=30
CI_MAX_JOB_ATTEMPTS=4

# mock (no API key needed, heuristic-based) | anthropic
CI_AI_PROVIDER=mock
CI_AI_MODEL=claude-sonnet-4-6
CI_AI_API_KEY=

CI_WEBHOOK_SECRET=change-me-webhook-secret
CI_JWT_SECRET=change-me-jwt-secret
