# Worker image: needs the Docker CLI/daemon socket to launch job containers,
# and git to be available inside the job containers it spawns (not here -
# the job's own image needs git; this image just needs docker-py + httpx).
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
CMD ["python", "-m", "app.worker.worker"]
